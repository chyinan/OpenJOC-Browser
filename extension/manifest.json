{
  "manifest_version": 3,
  "name": "OpenJOC Browser",
  "version": "0.1.0",
  "description": "Chromium playback integration for OpenJOC E-AC-3 JOC decoding without native Dolby decoding.",
  "action": {
    "default_title": "OpenJOC Browser"
  },
  "permissions": [
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.bilivideo.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["bilibili-main-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["bilibili-content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
